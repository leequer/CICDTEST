# 跨平台开发：统一换行符配置（参照 standards/templates/.gitattributes）
# 自动检测文本文件并转换换行符
* text=auto

# Python 文件使用 LF
*.py text eol=lf

# Shell 脚本使用 LF
*.sh text eol=lf

# YAML 配置文件使用 LF
*.yml text eol=lf
*.yaml text eol=lf

# Markdown 文档使用 LF
*.md text eol=lf

# JSON/TOML 配置文件使用 LF
*.json text eol=lf
*.toml text eol=lf

# 文本数据与依赖清单使用 LF
*.csv text eol=lf
requirements*.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# 二进制文件不转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
